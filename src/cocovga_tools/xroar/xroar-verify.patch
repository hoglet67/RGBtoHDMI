 static void render_scanline(struct MC6847_private *vdg);
 
+// Raw VDG frame dump for RGBtoHDMI CoCoVGA verification: with
+// XROAR_VDG_DUMP=file set, every frame is written as 262 lines x 912
+// palettised samples (enum vdg_colour); XROAR_VDG_DUMP_FRAMES=N quits
+// after N frames.
+#include <stdio.h>
+static FILE *vdg_dump_f;
+static int vdg_dump_init;
+static long vdg_dump_n, vdg_dump_max;
+static uint8_t vdg_dump_frame[VDG_FRAME_DURATION * VDG_LINE_DURATION];
+static void vdg_dump_line(unsigned scanline, unsigned frame, const uint8_t *data) {
+	if (!vdg_dump_init) {
+		vdg_dump_init = 1;
+		const char *f = getenv("XROAR_VDG_DUMP");
+		const char *n = getenv("XROAR_VDG_DUMP_FRAMES");
+		if (f) vdg_dump_f = fopen(f, "wb");
+		vdg_dump_max = n ? atol(n) : 0;
+	}
+	if (!vdg_dump_f || frame != 0 || scanline >= VDG_FRAME_DURATION)
+		return;
+	memcpy(vdg_dump_frame + scanline * VDG_LINE_DURATION, data, VDG_LINE_DURATION);
+	if (scanline == VDG_FRAME_DURATION - 1) {
+		fwrite(vdg_dump_frame, 1, sizeof(vdg_dump_frame), vdg_dump_f);
+		if (vdg_dump_max && ++vdg_dump_n >= vdg_dump_max) {
+			fclose(vdg_dump_f);
+			exit(0);
+		}
+	}
+}
+
 // Canonify scanline numbers:
 #define SCANLINE(s) ((s) % VDG_FRAME_DURATION)
 
